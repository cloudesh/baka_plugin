<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <AssemblyName>BakaPlugin</AssemblyName>
    <RootNamespace>BakaPlugin</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Name>Baka Free Company</Name>
    <Author>cloudesh</Author>
    <Punchline>Your company, together. A parchment roster for Shelter.</Punchline>
    <Description>A modern parchment-style roster for Shelter on Raiden. See online members, their jobs, locations, and game-reported activity. Open with /baka. Member data comes from the game's FC roster and may require opening the Members tab.</Description>
    <RepoUrl>https://github.com/cloudesh/baka_plugin</RepoUrl>
    <Tags>free company;social;baka;roster</Tags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
